# Frontend Environment Variables for SIH26161 Dam Break Inundation Modelling

# API Base URL
# The base URL for the FastAPI backend server.
# Override this to point to a different backend instance (e.g., staging or production).
#
# Examples:
#   VITE_API_BASE=http://127.0.0.1:8000     # Local development
#   VITE_API_BASE=http://localhost:8000       # Alternative local
#   VITE_API_BASE=https://your-domain.com/api   # Production VPS
#
# If not set, defaults to http://127.0.0.1:8000 (the local FastAPI backend).
VITE_API_BASE=http://127.0.0.1:8000

# Application Configuration
# Name displayed in the header/footer of the dashboard
VITE_APP_NAME=SIH26161 Dam Break Inundation Modelling
VITE_APP_VERSION=0.1.0